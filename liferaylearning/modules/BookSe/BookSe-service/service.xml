<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder dependency-injector="ds" package-path="com.ats.books">

    <namespace>BOOKKK</namespace>

    <!-- ====================== BOOKS ENTITY ====================== -->
    <entity name="Books" local-service="true" remote-service="false" uuid="true">
        <column name="bookId" primary="true" type="long" />
        <column name="groupId" type="long" />
        <column name="companyId" type="long" />
        <column name="userId" type="long" />
        <column name="userName" type="String" />
        <column name="createDate" type="Date" />
        <column name="modifiedDate" type="Date" />
        <column name="title" type="String" />
        <column name="author" type="String" />
        <column name="publishDate" type="Date" />
        <column name="categoryId" type="long" />




        <order by="asc">
            <order-column name="title" />
        </order>

        <finder name="ByAuthor" return-type="Collection">
            <finder-column name="author" />
        </finder>
        
       <!-- 
         <finder name="ByTitle" return-type="Collection">
        <finder-column name="title" />
    </finder>
        -->
        
    </entity>

    <!-- ====================== BOOK CATEGORY ENTITY ====================== -->
    <entity name="BookCategory" local-service="true" remote-service="false" uuid="true">
        <column name="categoryId" primary="true" type="long" />
        <column name="groupId" type="long" />
        <column name="companyId" type="long" />
        <column name="userId" type="long" />
        <column name="userName" type="String" />
        <column name="createDate" type="Date" />
        <column name="modifiedDate" type="Date" />
        <column name="categoryName" type="String" />
          <column name="bookId" type="long" /> 

        <order by="asc">
            <order-column name="categoryName" />
        </order>
        
         
    

        <finder name="ByCategoryName" return-type="Collection">
            <finder-column name="categoryName" />
        </finder>
        
        <reference entity="Books" package-path="com.ats.books" /> 
    </entity>

    <!-- ====================== FOO ENTITY ====================== -->
    <entity name="Foo" local-service="true" remote-service="true" uuid="true">
        <column name="fooId" primary="true" type="long" />
        <column name="groupId" type="long" />
        <column name="companyId" type="long" />
        <column name="userId" type="long" />
        <column name="userName" type="String" />
        <column name="createDate" type="Date" />
        <column name="modifiedDate" type="Date" />
