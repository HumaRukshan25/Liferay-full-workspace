<entity name="Author" local-service="true" remote-service="false">
    <column name="authorId" type="long" primary="true" />
    <column name="liferayUserId" type="long" />
    
    <!-- Add this finder block -->
    <finder name="LiferayUserId" return-type="Author">
        <finder-column name="liferayUserId" />
    </finder>
